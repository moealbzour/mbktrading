{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with CRM details, 3-tier entitlement (free/vip/elite), feature-scoped trials, and RBAC role in Firestore",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["free", "vip", "elite", "admin", "moderator", "sales", "analyser"] },
        "tier": { "type": "string", "enum": ["free", "vip", "elite"] },
        "isVip": { "type": "boolean" },
        "vipAccess": { "type": "boolean" },
        "vipExpiryDate": { "type": "string" },
        "isElite": { "type": "boolean" },
        "eliteExpiryDate": { "type": "string" },
        "grantedFeatures": { "type": "object" },
        "activationKey": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "dob": { "type": "string" },
        "experienceLevel": { "type": "string" },
        "assetClasses": { "type": "array", "items": { "type": "string" } },
        "favoritePairs": { "type": "string" },
        "telegramUsername": { "type": "string" },
        "totalPaid": { "type": "number" },
        "isBanned": { "type": "boolean" },
        "isMutedFromChat": { "type": "boolean" },
        "subscription_status": { "type": "string" },
        "subscription_end_date": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "lastNameChangeAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "ActivationKey": {
      "title": "ActivationKey",
      "description": "Single-use time-limited VIP, Elite, or custom feature-scoped trial key generated by admin",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "durationInDays": { "type": "number" },
        "durationLabel": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "used", "revoked"] },
        "keyType": { "type": "string", "enum": ["vip", "elite", "trial"] },
        "grantTier": { "type": "string", "enum": ["vip", "elite", "custom"] },
        "grantFeatures": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "usedByUserId": { "type": "string" },
        "usedByUserEmail": { "type": "string" },
        "usedAt": { "type": "string" }
      },
      "required": ["code", "durationInDays", "status"]
    },
    "Signal": {
      "title": "Signal",
      "description": "Trading signal published by admin or analyser",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "action": { "type": "string", "enum": ["BUY", "SELL", "BUY LIMIT", "SELL LIMIT"] },
        "entryPrice": { "type": "number" },
        "tp1": { "type": "number" },
        "tp2": { "type": "number" },
        "sl": { "type": "number" },
        "strategy": { "type": "string" },
        "timeframe": { "type": "string" },
        "notesAr": { "type": "string" },
        "notesEn": { "type": "string" },
        "author": { "type": "string" },
        "authorRole": { "type": "string" },
        "accessLevel": { "type": "string", "enum": ["free", "vip", "all"] },
        "status": { "type": "string" },
        "pips": { "type": "number" },
        "confidence": { "type": "number" },
        "createdAt": { "type": "string" },
        "timestampMs": { "type": "number" }
      },
      "required": ["symbol", "action", "entryPrice", "tp1", "sl", "accessLevel"]
    },
    "BotAlert": {
      "title": "BotAlert",
      "description": "TradingView webhook bot alert ingested via server webhook receiver",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^alert-[0-9]+-[a-z0-9]+$" },
        "text": { "type": "string", "maxLength": 2000 },
        "chat_id": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "timestampMs": { "type": "number" }
      },
      "required": ["id", "text", "timestamp", "timestampMs"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "General live chat message for all authenticated members (capped at 500 characters)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageCaption": { "type": "string" },
        "symbolTag": { "type": "string" },
        "replyTo": { "type": "object" },
        "isPinned": { "type": "boolean" },
        "likes": { "type": "number" },
        "reactions": { "type": "object" },
        "createdAt": { "type": "string" },
        "timestampMs": { "type": "number" }
      },
      "required": ["uid", "displayName", "text", "timestampMs"]
    },
    "VipChatMessage": {
      "title": "VipChatMessage",
      "description": "General chat message in chat_messages collection",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "content": { "type": "string" },
        "chartUrl": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["uid", "senderName", "content"]
    },
    "MarketIdea": {
      "title": "MarketIdea",
      "description": "Market analysis and trading ideas",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "symbol": { "type": "string" },
        "sentiment": { "type": "string", "enum": ["Bullish", "Bearish", "Neutral"] },
        "chartUrl": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array", "items": { "type": "string" } },
        "commentsCount": { "type": "number" },
        "comments": { "type": "array" },
        "createdAt": { "type": "string" },
        "timestampMs": { "type": "number" }
      },
      "required": ["title", "content", "symbol", "authorName"]
    },
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "User waitlist signup for upcoming features",
      "type": "object",
      "properties": {
        "serviceType": { "type": "string" },
        "serviceTitle": { "type": "string" },
        "preferredBroker": { "type": "string" },
        "accountSizeTier": { "type": "string" },
        "telegramContact": { "type": "string" },
        "userUid": { "type": "string" },
        "userEmail": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["serviceType", "telegramContact"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Dynamic platform support contact links configured by admin",
      "type": "object",
      "properties": {
        "whatsappNumber": { "type": "string", "maxLength": 40 },
        "telegramUrl": { "type": "string", "maxLength": 300 },
        "supportEmail": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["whatsappNumber", "telegramUrl"]
    },
    "ChatRoomSettings": {
      "title": "ChatRoomSettings",
      "description": "Live VIP chat room lock and reset state controlled by administrators",
      "type": "object",
      "properties": {
        "isClosed": { "type": "boolean" },
        "closedReason": { "type": "string", "maxLength": 300 },
        "closedBy": { "type": "string", "maxLength": 200 },
        "closedAt": { "type": "string", "maxLength": 64 },
        "resetAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["isClosed"]
    },
    "AppVersionSettings": {
      "title": "AppVersionSettings",
      "description": "Remote app version and force-reload broadcast trigger controlled by admin to push updates to all active tabs and PWA shortcuts",
      "type": "object",
      "properties": {
        "versionId": { "type": "string", "maxLength": 100 },
        "versionLabel": { "type": "string", "maxLength": 100 },
        "forceReloadAtMs": { "type": "number" },
        "resetLayout": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["versionId", "forceReloadAtMs"]
    },
    "ChatProfile": {
      "title": "ChatProfile",
      "description": "Public chat directory profile with DM opt-in/opt-out preference and blocked user list (no PII)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "maxLength": 40 },
        "allowDirectMessages": { "type": "boolean" },
        "blockedUids": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "displayName", "allowDirectMessages"]
    },
    "DmConversation": {
      "title": "DmConversation",
      "description": "Two-participant direct message conversation summary and unread counters",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantNames": { "type": "object" },
        "participantAvatars": { "type": "object" },
        "participantRoles": { "type": "object" },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastSenderUid": { "type": "string", "maxLength": 128 },
        "lastMessageAtMs": { "type": "number" },
        "unreadBy": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "participants", "lastMessageAtMs"]
    },
    "DmMessage": {
      "title": "DmMessage",
      "description": "Individual direct message between two platform users",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "maxLength": 128 },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 1000 },
        "timestampMs": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["senderUid", "recipientUid", "senderName", "text", "timestampMs"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Admin popup announcement or macro event warning targeted by tab and user segment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1500 },
        "type": { "type": "string", "enum": ["offer", "news", "event", "update"] },
        "targetTabs": { "type": "array", "items": { "type": "string" } },
        "targetAudience": { "type": "string", "enum": ["all", "free", "vip", "elite", "expiring_soon"] },
        "ctaType": { "type": "string", "enum": ["none", "plans", "promo", "calendar", "url"] },
        "ctaLabel": { "type": "string", "maxLength": 100 },
        "ctaUrl": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "timestampMs": { "type": "number" }
      },
      "required": ["id", "title", "message", "type", "targetTabs", "targetAudience", "isActive", "timestampMs"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Firestore user account profile registry & CRM"
    },
    "/activation_keys/{keyId}": {
      "schema": "ActivationKey",
      "description": "Single-use time-limited VIP, Elite, and custom feature trial keys generated by admin"
    },
    "/public_chat/{messageId}": {
      "schema": "ChatMessage",
      "description": "General live trading chat messages accessible to all members"
    },
    "/chat_profiles/{userId}": {
      "schema": "ChatProfile",
      "description": "Non-PII chat directory and direct-message privacy/block settings"
    },
    "/dm_conversations/{convoId}": {
      "schema": "DmConversation",
      "description": "User-to-user direct message threads"
    },
    "/dm_conversations/{convoId}/messages/{messageId}": {
      "schema": "DmMessage",
      "description": "Messages inside a user-to-user direct conversation"
    },
    "/chat_messages/{messageId}": {
      "schema": "VipChatMessage",
      "description": "General chat messages"
    },
    "/signals/{signalId}": {
      "schema": "Signal",
      "description": "Published trading signals (Free & VIP)"
    },
    "/bot_alerts/{alertId}": {
      "schema": "BotAlert",
      "description": "TradingView webhook bot alert logs"
    },
    "/engine_alerts/{alertId}": {
      "schema": "Signal",
      "description": "Legacy engine alerts (VIP/Admin)"
    },
    "/manual_signals/{signalId}": {
      "schema": "Signal",
      "description": "Legacy manual signals (VIP/Admin)"
    },
    "/market_ideas/{ideaId}": {
      "schema": "MarketIdea",
      "description": "Market ideas and technical analysis posts"
    },
    "/waitlist/{docId}": {
      "schema": "WaitlistEntry",
      "description": "Upcoming feature waitlist registrations"
    },
    "/settings/{settingId}": {
      "schema": "PlatformSettings",
      "description": "Dynamic platform settings such as support WhatsApp and Telegram links"
    },
    "/settings/chat_room": {
      "schema": "ChatRoomSettings",
      "description": "Temporary chat lock & reset state managed by admin/moderators"
    },
    "/settings/app_version": {
      "schema": "AppVersionSettings",
      "description": "Global force-reload and cache-purge broadcast state controlled by admin"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Admin popup announcements, offers, and macro event alerts"
    }
  }
}
