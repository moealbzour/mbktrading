rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // MBK TRADING - STRICT PRODUCTION FIRESTORE SECURITY RULES
    // ===============================================================

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Authentication & Identity Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdminToken() {
      return isSignedIn()
        && request.auth.token.email == 'moe.albzour@gmail.com';
    }

    function hasExplicitPermissionsMap() {
      return userDocExists()
        && userDoc().get('permissions', null) is map
        && userDoc().get('permissions', {}).size() > 0;
    }

    function hasGranularPermission(permKey) {
      return userDocExists()
        && userDoc().get('isBanned', false) != true
        && userDoc().get('permissions', {}) is map
        && permKey in userDoc().get('permissions', {})
        && userDoc().get('permissions', {})[permKey] == true;
    }

    function isAdmin() {
      return isSuperAdminToken()
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && (
              userDoc().role in ['admin', 'ADMIN']
              || userDoc().get('staffRole', 'none') == 'super_admin'
              || hasGranularPermission('canManageSystem')
            ));
    }

    function canManageChatPerm() {
      return isAdmin()
        || hasGranularPermission('canManageChat')
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && !hasExplicitPermissionsMap()
            && (
              userDoc().get('staffRole', 'none') == 'chat_moderator'
              || userDoc().role in ['moderator', 'MODERATOR']
            ));
    }

    function isModeratorOrAdmin() {
      return canManageChatPerm();
    }

    function canPostSignalsPerm() {
      return isAdmin()
        || hasGranularPermission('canPostSignals')
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && !hasExplicitPermissionsMap()
            && (
              userDoc().get('staffRole', 'none') == 'market_analyst'
              || userDoc().role in ['analyser', 'ANALYSER', 'analyst', 'ANALYST']
            ));
    }

    function canPostAnalysisPerm() {
      return isAdmin()
        || hasGranularPermission('canPostAnalysis')
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && !hasExplicitPermissionsMap()
            && (
              userDoc().get('staffRole', 'none') == 'market_analyst'
              || userDoc().role in ['analyser', 'ANALYSER', 'analyst', 'ANALYST']
            ));
    }

    function isAnalyser() {
      return canPostSignalsPerm() || canPostAnalysisPerm();
    }

    function canManageUsersPerm() {
      return isAdmin()
        || hasGranularPermission('canManageUsers')
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && !hasExplicitPermissionsMap()
            && userDoc().get('staffRole', 'none') == 'operations_manager');
    }

    function canAccessInboxPerm() {
      return isAdmin()
        || hasGranularPermission('canAccessInbox')
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && !hasExplicitPermissionsMap()
            && (
              userDoc().get('staffRole', 'none') in ['customer_service', 'operations_manager']
              || userDoc().role in ['sales', 'SALES']
            ));
    }

    function canSendPopupsPerm() {
      return isAdmin()
        || hasGranularPermission('canSendPopups')
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && !hasExplicitPermissionsMap()
            && userDoc().get('staffRole', 'none') == 'operations_manager');
    }

    function canViewAnalyticsPerm() {
      return isAdmin()
        || hasGranularPermission('canViewAnalytics')
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && !hasExplicitPermissionsMap()
            && userDoc().get('staffRole', 'none') == 'operations_manager');
    }

    function canReadUsersDirectory() {
      return isAdmin()
        || canManageUsersPerm()
        || canViewAnalyticsPerm()
        || canSendPopupsPerm();
    }

    function isStaff() {
      return isAdmin()
        || canManageChatPerm()
        || canPostSignalsPerm()
        || canPostAnalysisPerm()
        || canAccessInboxPerm()
        || canManageUsersPerm()
        || canSendPopupsPerm()
        || canViewAnalyticsPerm();
    }

    function isBanned() {
      return !isSuperAdminToken() && userDocExists() && userDoc().get('isBanned', false) == true;
    }

    function isMutedFromChat() {
      return !isModeratorOrAdmin() && userDocExists() && userDoc().get('isMutedFromChat', false) == true;
    }

    function isActiveVIP() {
      return isStaff()
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && (
              userDoc().role in ['vip', 'VIP', 'elite', 'ELITE']
              || userDoc().get('tier', 'free') in ['vip', 'elite']
              || userDoc().get('isVip', false) == true
              || userDoc().get('vipAccess', false) == true
              || userDoc().get('isElite', false) == true
              || userDoc().get('subscription_status', 'none') == 'active'
            ));
    }

    function hasGrantedFeature(featureKey) {
      return isActiveVIP()
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && userDoc().get('grantedFeatures', {}) is map
            && featureKey in userDoc().get('grantedFeatures', {})
            && userDoc().get('grantedFeatures', {})[featureKey] is string);
    }

    // Atomic Single-Use Key Redemption Verification (VIP, Elite, or Feature Trial)
    function isValidKeyTransaction(keyId) {
      return keyId is string
        && isValidId(keyId)
        && get(/databases/$(database)/documents/activation_keys/$(keyId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/activation_keys/$(keyId)).data.status == 'used'
        && getAfter(/databases/$(database)/documents/activation_keys/$(keyId)).data.usedByUserId == request.auth.uid;
    }

    function isValidVipKeyRedemption(userId) {
      let keyId = incoming().activationKey;
      let keyData = get(/databases/$(database)/documents/activation_keys/$(keyId)).data;
      return isOwner(userId)
        && !isBanned()
        && isValidKeyTransaction(keyId)
        && keyData.get('grantTier', 'vip') == 'vip'
        && incoming().role == 'vip'
        && incoming().isVip == true
        && incoming().vipAccess == true
        && incoming().subscription_status == 'active';
    }

    function isValidEliteKeyRedemption(userId) {
      let keyId = incoming().activationKey;
      let keyData = get(/databases/$(database)/documents/activation_keys/$(keyId)).data;
      return isOwner(userId)
        && !isBanned()
        && isValidKeyTransaction(keyId)
        && keyData.get('grantTier', 'vip') == 'elite'
        && incoming().role == 'vip'
        && incoming().tier == 'elite'
        && incoming().isVip == true
        && incoming().vipAccess == true
        && incoming().isElite == true
        && incoming().subscription_status == 'active';
    }

    function isValidCustomTrialKeyRedemption(userId) {
      let keyId = incoming().activationKey;
      let keyData = get(/databases/$(database)/documents/activation_keys/$(keyId)).data;
      return isOwner(userId)
        && !isBanned()
        && isValidKeyTransaction(keyId)
        && keyData.get('grantTier', 'vip') == 'custom'
        && incoming().grantedFeatures is map
        && incoming().grantedFeatures.diff(existing().get('grantedFeatures', {})).affectedKeys().hasOnly(keyData.get('grantFeatures', []));
    }

    function isValidUserCreate(userId) {
      let data = incoming();
      let safeDefaultUser = data.role == 'free'
        && data.get('tier', 'free') == 'free'
        && data.get('isVip', false) == false
        && data.get('vipAccess', false) == false
        && data.get('isElite', false) == false
        && data.get('grantedFeatures', {}) == {}
        && data.get('isBanned', false) == false
        && data.get('isMutedFromChat', false) == false
        && data.get('totalPaid', 0) == 0;
      return isOwner(userId)
        && (safeDefaultUser || isValidVipKeyRedemption(userId) || isValidEliteKeyRedemption(userId))
        && data.get('email', '') is string
        && data.get('email', '').size() <= 200
        && data.get('displayName', '') is string
        && data.get('displayName', '').size() <= 100
        && data.get('phone', '') is string
        && data.get('phone', '').size() <= 40
        && data.get('country', '') is string
        && data.get('country', '').size() <= 80;
    }

    function isSafeOwnerProfileUpdate(userId) {
      let affected = incoming().diff(existing()).affectedKeys();
      let displayNameChanged = affected.hasAny(['displayName']) && incoming().displayName != existing().get('displayName', '');
      return isOwner(userId)
        && !isBanned()
        && affected.hasOnly([
          'displayName',
          'lastNameChangeAt',
          'phone',
          'country',
          'dob',
          'experienceLevel',
          'assetClasses',
          'favoritePairs',
          'avatar',
          'emailVerified',
          'telegramUsername',
          'updatedAt',
          'lastActiveAt'
        ])
        && (
          (!displayNameChanged && !affected.hasAny(['lastNameChangeAt']))
          || (
            displayNameChanged
            && affected.hasAll(['displayName', 'lastNameChangeAt'])
            && incoming().displayName is string
            && incoming().displayName.size() >= 2
            && incoming().displayName.size() <= 100
            && incoming().lastNameChangeAt == request.time
            && (
              !('lastNameChangeAt' in existing())
              || existing().lastNameChangeAt == null
              || (existing().lastNameChangeAt is timestamp && existing().lastNameChangeAt + duration.value(7, 'd') <= request.time)
            )
          )
        )
        && (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 100))
        && (!('phone' in incoming()) || (incoming().phone is string && incoming().phone.size() <= 40))
        && (!('country' in incoming()) || (incoming().country is string && incoming().country.size() <= 80))
        && (!('dob' in incoming()) || (incoming().dob is string && incoming().dob.size() <= 32))
        && (!('experienceLevel' in incoming()) || (incoming().experienceLevel is string && incoming().experienceLevel.size() <= 40))
        && (!('favoritePairs' in incoming()) || (incoming().favoritePairs is string && incoming().favoritePairs.size() <= 200))
        && (!('telegramUsername' in incoming()) || (incoming().telegramUsername is string && incoming().telegramUsername.size() <= 80))
        && (!('assetClasses' in incoming()) || (incoming().assetClasses is list && incoming().assetClasses.size() <= 10));
    }

    function isAtomicUserUpgradeUpdate(userId) {
      let affected = incoming().diff(existing()).affectedKeys();
      return (
        isValidVipKeyRedemption(userId)
        && affected.hasOnly([
          'role',
          'tier',
          'isVip',
          'vipAccess',
          'vipExpiryDate',
          'subscription_status',
          'subscription_end_date',
          'activationKey',
          'updatedAt'
        ])
      ) || (
        isValidEliteKeyRedemption(userId)
        && affected.hasOnly([
          'role',
          'tier',
          'isVip',
          'vipAccess',
          'isElite',
          'vipExpiryDate',
          'eliteExpiryDate',
          'subscription_status',
          'subscription_end_date',
          'activationKey',
          'updatedAt'
        ])
      ) || (
        isValidCustomTrialKeyRedemption(userId)
        && affected.hasOnly([
          'grantedFeatures',
          'activationKey',
          'updatedAt'
        ])
      );
    }

    // ---------------------------------------------------------------
    // 1. USERS COLLECTION (Strict Ownership + Protected Privileges)
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || canReadUsersDirectory() || canManageChatPerm());
      allow list: if canReadUsersDirectory();
      allow create: if isValidId(userId) && (isValidUserCreate(userId) || isAdmin());
      allow update: if isValidId(userId) && (
        isSafeOwnerProfileUpdate(userId)
        || isAtomicUserUpgradeUpdate(userId)
        || isAdmin()
        || (
          canManageUsersPerm()
          && !(incoming().get('role', '') in ['admin', 'ADMIN'])
          && incoming().get('staffRole', 'none') != 'super_admin'
          && !incoming().diff(existing()).affectedKeys().hasAny(['permissions', 'staffRole'])
        )
        || (
          canManageChatPerm()
          && incoming().diff(existing()).affectedKeys().hasOnly(['isMutedFromChat', 'updatedAt', 'uid'])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // ---------------------------------------------------------------
    // 2. ACTIVATION KEYS (Admin CRUD, Authenticated Single-Use Transaction)
    // ---------------------------------------------------------------
    match /activation_keys/{keyId} {
      allow get: if isValidId(keyId) && isSignedIn();
      allow list: if isAdmin() || isStaff();
      allow create: if isValidId(keyId)
        && isAdmin()
        && incoming().code == keyId
        && incoming().status == 'active'
        && incoming().durationInDays is number
        && incoming().durationInDays > 0;
      allow update: if isValidId(keyId) && (
        isAdmin()
        || (isSignedIn()
            && !isBanned()
            && existing().status == 'active'
            && incoming().status == 'used'
            && incoming().usedByUserId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedByUserId', 'usedByUserEmail', 'usedAt'])
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.activationKey == keyId)
      );
      allow delete: if isValidId(keyId) && isAdmin();
    }

    function isChatRoomClosed() {
      return exists(/databases/$(database)/documents/settings/chat_room)
        && get(/databases/$(database)/documents/settings/chat_room).data.get('isClosed', false) == true;
    }

    // ---------------------------------------------------------------
    // 3. GENERAL CHAT (Zero extra get() reads on public get/list; standalone canManageChat moderation)
    // ---------------------------------------------------------------
    match /public_chat/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(messageId) && (
        isAdmin()
        || (
          isSignedIn()
          && !isBanned()
          && !isMutedFromChat()
          && (!isChatRoomClosed() || canManageChatPerm())
          && incoming().uid == request.auth.uid
          && incoming().displayName is string
          && incoming().displayName.size() >= 1
          && incoming().displayName.size() <= 100
          && incoming().text is string
          && incoming().text.size() <= 500
          && (incoming().text.size() >= 1 || (canManageChatPerm() && incoming().imageUrl is string))
          && (incoming().get('imageUrl', null) == null
              || (canManageChatPerm() && incoming().imageUrl is string && incoming().imageUrl.size() <= 1048000))
          && incoming().get('isPinned', false) == false
          && incoming().get('likes', 0) == 0
        )
      );
      allow update: if isValidId(messageId) && (
        (isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'likes']))
        || (isSignedIn()
          && existing().uid == request.auth.uid
          && !isBanned()
          && !isMutedFromChat()
          && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'editedAt'])
          && incoming().text is string
          && incoming().text.size() >= 1
          && incoming().text.size() <= 500)
        || canManageChatPerm()
      );
      allow delete: if isValidId(messageId) && (
        (isSignedIn() && existing().uid == request.auth.uid && !isBanned())
        || canManageChatPerm()
      );
    }

    match /chat_messages/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(messageId)
        && isSignedIn()
        && !isBanned()
        && !isMutedFromChat()
        && incoming().uid == request.auth.uid
        && incoming().content is string
        && incoming().content.size() >= 1
        && incoming().content.size() <= 500;
      allow update, delete: if isValidId(messageId) && canManageChatPerm();
    }

    // ---------------------------------------------------------------
    // 3b. DIRECT MESSAGES & USER DM PRIVACY DIRECTORY
    // ---------------------------------------------------------------
    function isValidChatProfile(data, userId) {
      return data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.allowDirectMessages is bool
        && (!('blockedUids' in data) || (data.blockedUids is list && data.blockedUids.size() <= 200))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000))
        && (!('role' in data) || (data.role is string && data.role.size() <= 40));
    }

    function canReceiveDirectMessage(senderUid, recipientUid) {
      let profilePath = /databases/$(database)/documents/chat_profiles/$(recipientUid);
      return isAdmin()
        || !exists(profilePath)
        || (
          get(profilePath).data.get('allowDirectMessages', true) == true
          && !(senderUid in get(profilePath).data.get('blockedUids', []))
        );
    }

    match /chat_profiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && !isBanned();
      allow list: if isStaff();
      allow create, update: if isValidId(userId)
        && (isOwner(userId) || isAdmin() || isStaff())
        && !isBanned();
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /dm_conversations/{convoId} {
      allow get: if isValidId(convoId)
        && isSignedIn()
        && (
          (resource == null && (convoId.matches('^.*' + request.auth.uid + '.*$') || convoId.matches('^.*mbktrading.*$')))
          || (resource != null && request.auth.uid in resource.data.participants)
          || (resource != null && 'mbktrading' in resource.data.participants && canAccessInboxPerm())
          || isAdmin()
          || canViewAnalyticsPerm()
        );
      allow list: if isSignedIn()
        && (
          request.auth.uid in resource.data.participants
          || ('mbktrading' in resource.data.participants && (canAccessInboxPerm() || canViewAnalyticsPerm()))
          || isAdmin()
        );
      allow create: if isValidId(convoId) && (
        (
          isSignedIn()
          && !isBanned()
          && incoming().id == convoId
          && incoming().participants is list
          && incoming().participants.size() == 2
          && incoming().participants[0] != incoming().participants[1]
          && request.auth.uid in incoming().participants
          && incoming().lastSenderUid == request.auth.uid
          && incoming().lastMessage is string
          && incoming().lastMessage.size() <= 500
          && incoming().lastMessageAtMs is number
          && (
            incoming().participants[0] == request.auth.uid
              ? canReceiveDirectMessage(request.auth.uid, incoming().participants[1])
              : canReceiveDirectMessage(request.auth.uid, incoming().participants[0])
          )
        )
        || ('mbktrading' in incoming().participants && canAccessInboxPerm())
        || canSendPopupsPerm()
        || isAdmin()
      );
      allow update: if isValidId(convoId) && (
        (
          isSignedIn()
          && !isBanned()
          && request.auth.uid in existing().participants
          && incoming().participants == existing().participants
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['unreadBy', 'updatedAt'])
            || (
              incoming().lastSenderUid == request.auth.uid
              && incoming().lastMessage is string
              && incoming().lastMessage.size() <= 500
              && (
                existing().participants[0] == request.auth.uid
                  ? canReceiveDirectMessage(request.auth.uid, existing().participants[1])
                  : canReceiveDirectMessage(request.auth.uid, existing().participants[0])
              )
            )
          )
        )
        || ('mbktrading' in existing().participants && canAccessInboxPerm())
        || canSendPopupsPerm()
        || isAdmin()
      );
      allow delete: if isValidId(convoId) && isAdmin();

      match /messages/{msgId} {
        allow get: if isValidId(convoId)
          && isValidId(msgId)
          && isSignedIn()
          && (
            convoId.matches('^.*' + request.auth.uid + '.*$')
            || (convoId.matches('^.*mbktrading.*$') && canAccessInboxPerm())
            || isAdmin()
          );
        allow list: if isValidId(convoId)
          && isSignedIn()
          && (
            convoId.matches('^.*' + request.auth.uid + '.*$')
            || (convoId.matches('^.*mbktrading.*$') && canAccessInboxPerm())
            || isAdmin()
          );
        allow create: if isValidId(convoId)
          && isValidId(msgId)
          && (
            (
              isSignedIn()
              && !isBanned()
              && incoming().senderUid == request.auth.uid
              && incoming().recipientUid is string
              && incoming().recipientUid != request.auth.uid
              && convoId.matches('^.*' + request.auth.uid + '.*$')
              && canReceiveDirectMessage(request.auth.uid, incoming().recipientUid)
              && incoming().text is string
              && incoming().text.size() >= 1
              && incoming().text.size() <= 1000
              && incoming().timestampMs is number
            )
            || (convoId.matches('^.*mbktrading.*$') && canAccessInboxPerm())
            || canSendPopupsPerm()
            || isAdmin()
          );
        allow update: if isValidId(convoId) && isValidId(msgId) && (
          (
            isSignedIn()
            && !isBanned()
            && existing().senderUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'editedAt'])
            && incoming().text is string
            && incoming().text.size() >= 1
            && incoming().text.size() <= 1000
          )
          || (convoId.matches('^.*mbktrading.*$') && canAccessInboxPerm())
          || isAdmin()
        );
        allow delete: if isValidId(convoId) && isValidId(msgId) && (
          (isSignedIn() && existing().senderUid == request.auth.uid && !isBanned())
          || (convoId.matches('^.*mbktrading.*$') && canAccessInboxPerm())
          || isAdmin()
        );
      }
    }

    // ---------------------------------------------------------------
    // 4. SIGNALS & BOT ALERTS (Standalone canPostSignals Writes, Tiered & Trial Reads)
    // ---------------------------------------------------------------
    match /signals/{signalId} {
      allow get: if isValidId(signalId) && (
        signalId == 'connection-check'
        || resource == null
        || resource.data.get('accessLevel', 'free') in ['free', 'all']
        || resource.data.get('access_level', 'free') in ['free', 'all']
        || hasGrantedFeature('vipSignals')
        || canPostSignalsPerm()
        || canViewAnalyticsPerm()
      );
      allow list: if resource.data.get('accessLevel', 'free') in ['free', 'all']
        || resource.data.get('access_level', 'free') in ['free', 'all']
        || hasGrantedFeature('vipSignals')
        || canPostSignalsPerm()
        || canViewAnalyticsPerm();
      allow create: if isValidId(signalId)
        && canPostSignalsPerm()
        && incoming().symbol is string
        && incoming().symbol.size() >= 2
        && incoming().symbol.size() <= 30
        && incoming().action is string
        && incoming().entryPrice is number
        && incoming().tp1 is number
        && incoming().sl is number;
      allow update, delete: if isValidId(signalId) && canPostSignalsPerm();
    }

    function isValidBotAlertCreate(alertId, data) {
      return alertId.matches('^alert-[0-9]+-[a-z0-9]+$')
        && data.keys().hasAll(['id', 'text', 'timestamp', 'timestampMs'])
        && data.keys().hasOnly(['id', 'text', 'chat_id', 'timestamp', 'timestampMs'])
        && data.id == alertId
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 2000
        && (!('chat_id' in data) || data.chat_id == null || (data.chat_id is string && data.chat_id.size() <= 100))
        && data.timestamp is string
        && data.timestamp.size() >= 1
        && data.timestamp.size() <= 64
        && data.timestampMs is int
        && data.timestampMs > 0;
    }

    match /bot_alerts/{alertId} {
      allow get: if isValidId(alertId) && (hasGrantedFeature('botSignals') || canPostSignalsPerm() || canViewAnalyticsPerm());
      allow list: if hasGrantedFeature('botSignals') || canPostSignalsPerm() || canViewAnalyticsPerm();
      allow create: if isValidId(alertId) && (
        isValidBotAlertCreate(alertId, incoming())
        || canPostSignalsPerm()
      );
      allow update, delete: if isValidId(alertId) && canPostSignalsPerm();
    }

    match /engine_alerts/{alertId} {
      allow get: if isValidId(alertId) && (hasGrantedFeature('botSignals') || canPostSignalsPerm() || canViewAnalyticsPerm());
      allow list: if hasGrantedFeature('botSignals') || canPostSignalsPerm() || canViewAnalyticsPerm();
      allow create, update, delete: if isValidId(alertId) && canPostSignalsPerm();
    }

    match /manual_signals/{signalId} {
      allow get: if isValidId(signalId) && (hasGrantedFeature('vipSignals') || canPostSignalsPerm() || canViewAnalyticsPerm());
      allow list: if hasGrantedFeature('vipSignals') || canPostSignalsPerm() || canViewAnalyticsPerm();
      allow create, update, delete: if isValidId(signalId) && canPostSignalsPerm();
    }

    // ---------------------------------------------------------------
    // 5. MARKET IDEAS & ANALYSIS HUB (Standalone canPostAnalysis Writes)
    // ---------------------------------------------------------------
    function canPublishMarketAnalysis() {
      return canPostAnalysisPerm()
        || (userDocExists()
            && userDoc().get('isBanned', false) != true
            && userDoc().get('grantedFeatures', {}) is map
            && 'publishAnalysis' in userDoc().get('grantedFeatures', {})
            && userDoc().get('grantedFeatures', {})['publishAnalysis'] is string);
    }

    match /market_ideas/{ideaId} {
      allow get: if isValidId(ideaId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(ideaId)
        && isSignedIn()
        && canPublishMarketAnalysis()
        && incoming().title is string
        && incoming().title.size() >= 1
        && incoming().title.size() <= 200
        && incoming().content is string
        && incoming().content.size() >= 1
        && incoming().content.size() <= 8000;
      allow update: if isValidId(ideaId) && (
        (isSignedIn()
            && incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount', 'comments', 'commentsCount']))
        || canPublishMarketAnalysis()
      );
      allow delete: if isValidId(ideaId) && (isAdmin() || (canPublishMarketAnalysis() && existing().authorId == request.auth.uid));
    }

    match /market_analysis/{analysisId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(analysisId) && canPublishMarketAnalysis();
      allow delete: if isValidId(analysisId) && (isAdmin() || canPublishMarketAnalysis());
    }

    match /waitlist/{docId} {
      allow create: if isValidId(docId)
        && incoming().serviceType is string
        && incoming().serviceType.size() >= 1
        && incoming().serviceType.size() <= 100
        && incoming().telegramContact is string
        && incoming().telegramContact.size() >= 2
        && incoming().telegramContact.size() <= 200;
      allow read, update, delete: if isValidId(docId) && isStaff();
    }

    // ---------------------------------------------------------------
    // 6. PLATFORM SETTINGS (Public get for contact links, Admin writes)
    // ---------------------------------------------------------------
    function isValidPlatformSettings(data) {
      return data.keys().hasAll(['whatsappNumber', 'telegramUrl'])
        && data.keys().hasOnly(['whatsappNumber', 'telegramUrl', 'supportEmail', 'updatedAt', 'updatedBy'])
        && data.whatsappNumber is string
        && data.whatsappNumber.size() <= 40
        && data.telegramUrl is string
        && data.telegramUrl.size() <= 300
        && (!('supportEmail' in data) || (data.supportEmail is string && data.supportEmail.size() <= 200))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    function isValidChatRoomSettings(data) {
      return data.keys().hasAll(['isClosed'])
        && data.keys().hasOnly(['isClosed', 'closedReason', 'closedBy', 'closedAt', 'resetAtMs', 'updatedAt'])
        && data.isClosed is bool
        && (!('closedReason' in data) || data.closedReason == null || (data.closedReason is string && data.closedReason.size() <= 300))
        && (!('closedBy' in data) || data.closedBy == null || (data.closedBy is string && data.closedBy.size() <= 200))
        && (!('closedAt' in data) || data.closedAt == null || (data.closedAt is string && data.closedAt.size() <= 64))
        && (!('resetAtMs' in data) || data.resetAtMs == null || (data.resetAtMs is number && data.resetAtMs >= 0))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAppVersionSettings(data) {
      return data.keys().hasAll(['versionId', 'forceReloadAtMs'])
        && data.keys().hasOnly(['versionId', 'versionLabel', 'forceReloadAtMs', 'resetLayout', 'updatedAt', 'updatedBy'])
        && data.versionId is string
        && data.versionId.size() >= 1
        && data.versionId.size() <= 100
        && data.forceReloadAtMs is number
        && data.forceReloadAtMs >= 0
        && (!('versionLabel' in data) || data.versionLabel == null || (data.versionLabel is string && data.versionLabel.size() <= 100))
        && (!('resetLayout' in data) || data.resetLayout is bool)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    function isValidPricingSettings(data) {
      return data.keys().hasAll(['vipMonthlyUsd', 'eliteMonthlyUsd', 'syncToPublicPlans'])
        && data.keys().hasOnly(['vipMonthlyUsd', 'eliteMonthlyUsd', 'syncToPublicPlans', 'updatedAt', 'updatedBy'])
        && data.vipMonthlyUsd is number
        && data.vipMonthlyUsd >= 0
        && data.vipMonthlyUsd <= 100000
        && data.eliteMonthlyUsd is number
        && data.eliteMonthlyUsd >= 0
        && data.eliteMonthlyUsd <= 100000
        && data.syncToPublicPlans is bool
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (
        settingId == 'platform'
        || settingId == 'app_version'
        || settingId == 'pricing'
        || (settingId == 'chat_room' && isSignedIn())
        || isAdmin()
      );
      allow list: if isAdmin();
      allow create, update: if isValidId(settingId) && (
        (settingId == 'chat_room' && isModeratorOrAdmin() && isValidChatRoomSettings(incoming()))
        || (settingId == 'app_version' && isAdmin() && isValidAppVersionSettings(incoming()))
        || (settingId == 'platform' && isAdmin() && isValidPlatformSettings(incoming()))
        || (settingId == 'pricing' && isAdmin() && isValidPricingSettings(incoming()))
      );
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // ---------------------------------------------------------------
    // 7. ADMIN POPUP ANNOUNCEMENTS, MACRO WARNINGS & SAVED TEMPLATES
    // ---------------------------------------------------------------
    function isValidAnnouncement(data, docId) {
      return data.id == docId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 1500
        && data.type in ['offer', 'news', 'event', 'update']
        && data.targetTabs is list
        && data.targetTabs.size() >= 1
        && data.targetTabs.size() <= 20
        && data.targetAudience in ['all', 'free', 'vip', 'elite', 'expiring_soon', 'expired']
        && data.isActive is bool
        && data.timestampMs is number;
    }

    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(announcementId) && canSendPopupsPerm() && isValidAnnouncement(incoming(), announcementId);
      allow update: if isValidId(announcementId) && (
        (canSendPopupsPerm() && isValidAnnouncement(incoming(), announcementId))
        || (isSignedIn()
            && !isBanned()
            && incoming().diff(existing()).affectedKeys().hasOnly(['views', 'clicks']))
      );
      allow delete: if isValidId(announcementId) && canSendPopupsPerm();
    }

    match /admin_templates/{templateId} {
      allow get, list: if canSendPopupsPerm();
      allow create, update: if isValidId(templateId)
        && canSendPopupsPerm()
        && incoming().name is string
        && incoming().name.size() >= 1
        && incoming().name.size() <= 120
        && incoming().templateType in ['popup', 'dm']
        && incoming().payload is map
        && incoming().timestampMs is number;
      allow delete: if isValidId(templateId) && canSendPopupsPerm();
    }

    // ---------------------------------------------------------------
    // 8. MBK STORE PRODUCTS (Signed-In Reads, Admin Writes)
    // ---------------------------------------------------------------
    match /store_products/{productId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 9. MBK PRO CHART SETUPS (Signed-In Reads, Admin/Analyser Writes)
    // ---------------------------------------------------------------
    match /chart_setups/{symbol} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() || isAnalyser();
    }

    // ---------------------------------------------------------------
    // 10. WEB PUSH SUBSCRIPTIONS (Non-PII VAPID Endpoints — Self/Admin Writes, Server REST Reads)
    // ---------------------------------------------------------------
    match /push_subscriptions/{uid} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ---------------------------------------------------------------
    // 11. MBK TRADING ACADEMY VIDEOS & SHORTS (Signed-In Reads, Admin Writes)
    // ---------------------------------------------------------------
    match /academy_videos/{videoId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 12. STAFF AUDIT LOGS (Staff Create, Super Admin Read, Immutable)
    // ---------------------------------------------------------------
    match /admin_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId)
        && isStaff()
        && incoming().actorUid == request.auth.uid
        && incoming().actorName is string
        && incoming().actorName.size() <= 140
        && incoming().action is string
        && incoming().action.size() <= 100
        && incoming().details is string
        && incoming().details.size() <= 1000
        && incoming().timestampMs is number;
      allow update, delete: if false;
    }
  }
}



