{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/webhook/tradingview",
      "destination": "/api/webhooks/tradingview"
    },
    {
      "source": "/api/gemini/agent",
      "destination": "/api/gemini/chat"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
